<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:launchMode="singleTop"
    android:screenOrientation="landscape"
    android:configChanges="orientation|navigation|keyboardHidden|keyboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">
    <LinearLayout
        android:orientation="vertical"
        android:background="#00000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.exoplayer2.p003ui.StyledPlayerView
            android:layout_gravity="center"
            android:id="@+id/video_view1"
            android:background="#000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.google.android.exoplayer2.p003ui.StyledPlayerView
            android:layout_gravity="center"
            android:id="@+id/video_view2"
            android:background="#000000"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progressBar"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:progressTintMode="multiply"
        android:indeterminateTint="@color/selected_background"
        style="?android:attr/progressBarStyleLarge"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/slidingPanel"
        android:background="#5f000000"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="100sp">
        <ProgressBar
            android:id="@+id/timeProgress"
            android:background="#00000000"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/selected_background"
            android:progressBackgroundTint="#5f000000"
            style="@android:style/Widget.ProgressBar.Horizontal"/>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:background="#5f000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false">
            <LinearLayout
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:background="#00000000"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="8">
                <ImageView
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/siteView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/wavve_icon_24"
                    android:layout_marginStart="10dp"/>
                <TextView
                    android:textSize="20sp"
                    android:textColor="#ffffffff"
                    android:gravity="start|center_vertical"
                    android:id="@+id/infoView"
                    android:background="#00000000"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"/>
            </LinearLayout>
            <Space
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_weight="0"/>
            <LinearLayout
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:background="#00000000"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <TextView
                    android:textSize="20sp"
                    android:textColor="#ffffffff"
                    android:layout_gravity="end|top"
                    android:id="@+id/timeView"
                    android:background="#00000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10sp"
                    android:layout_marginEnd="30sp"/>
                <LinearLayout
                    android:layout_gravity="end|bottom"
                    android:orientation="horizontal"
                    android:background="#00000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10sp"
                    android:layout_marginEnd="30sp">
                    <ImageView
                        android:layout_gravity="start|bottom"
                        android:id="@+id/favoriteView"
                        android:visibility="invisible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/star_icon_32"
                        android:layout_marginStart="10sp"/>
                    <TextView
                        android:textSize="20sp"
                        android:textColor="#ffffffff"
                        android:layout_gravity="end|bottom"
                        android:id="@+id/resView"
                        android:background="#00000000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
