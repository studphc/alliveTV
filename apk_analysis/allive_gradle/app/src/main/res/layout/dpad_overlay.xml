<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#00ffffff"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="top"
        android:orientation="horizontal"
        android:background="#00ffffff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <ImageButton
            android:id="@+id/backButton"
            android:background="#00ffffff"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/closebtn_states"
            android:onClick="onSettingButtonClick"
            android:layout_marginStart="10dp"/>
        <ImageButton
            android:id="@+id/upButton"
            android:background="#00ffffff"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/upbtn_states"
            android:onClick="onSettingButtonClick"
            android:layout_marginStart="5dp"/>
        <ImageButton
            android:id="@+id/downButton"
            android:background="#00ffffff"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/downbtn_states"
            android:onClick="onSettingButtonClick"
            android:layout_marginStart="5dp"/>
        <ImageButton
            android:id="@+id/selectButton"
            android:background="#00ffffff"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/selectbtn_states"
            android:onClick="onSettingButtonClick"
            android:layout_marginStart="5dp"/>
        <ImageButton
            android:id="@+id/leftButton"
            android:background="#00ffffff"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/leftbtn_states"
            android:onClick="onSettingButtonClick"
            android:layout_marginStart="5dp"/>
        <ImageButton
            android:id="@+id/rightButton"
            android:background="#00ffffff"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/rightbtn_states"
            android:onClick="onSettingButtonClick"
            android:layout_marginStart="5dp"/>
    </LinearLayout>
</LinearLayout>
